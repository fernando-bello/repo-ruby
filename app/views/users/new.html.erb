<% content_for :title, "Cadastro de usuário" %>

<h1>Cadastro de usuário</h1>

<%= form_with model: @user do |form| %>
  <% if @user.errors.any? %>
    <div class="errors" role="alert">
      <p>Não foi possível salvar o cadastro:</p>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Nome" %>
    <%= form.text_field :name, required: true, autofocus: true %>
  </div>

  <div class="field">
    <%= form.label :email, "E-mail" %>
    <%= form.email_field :email, required: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= form.label :password, "Senha (mínimo 8 caracteres)" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "Confirme a senha" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
  </div>

  <%= form.submit "Cadastrar" %>
<% end %>

<p><%= link_to "Ver usuários cadastrados", users_path %></p>
